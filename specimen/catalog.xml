     sdc4/schemas/sdc4.xsd in SemanticDataCharter/SDCRM release v4.1.0 (Apache-2.0). -->
<catalog xmlns="urn:oasis:names:tc:entity:xmlns:xml:catalog">
  <uri name="https://semanticdatacharter.com/ns/sdc4/sdc4.xsd" uri="reference-model/sdc4.xsd"/>
  <system systemId="https://semanticdatacharter.com/ns/sdc4/sdc4.xsd" uri="reference-model/sdc4.xsd"/>
</catalog>
